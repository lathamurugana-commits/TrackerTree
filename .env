# ─── EmailJS Configuration ────────────────────────────────────────────
# Get these from https://dashboard.emailjs.com
# 1. Service ID   → Email Services → your connected email service
# 2. Template ID  → Email Templates → your receipt template
# 3. Public Key   → Account → General → Public Key

VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY

# ─── Cloudinary Configuration ─────────────────────────────────────────
# Cloud Name  → Cloudinary Dashboard (top-right)
# Upload Preset → Settings → Upload → Upload Presets (must be unsigned)

VITE_CLOUDINARY_CLOUD_NAME=usekoxch
VITE_CLOUDINARY_UPLOAD_PRESET=TrackerTree
